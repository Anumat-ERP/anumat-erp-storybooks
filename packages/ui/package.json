{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./styles/*": "./src/styles/*"
  },
  "scripts": {
    "build:theme": "node scripts/build-theme.mjs",
    "generate": "node scripts/generate.mjs",
    "status": "node scripts/status.mjs",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build --quiet"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "radix-ui": "^1.4.3",
    "class-variance-authority": "^0.7.1",
    "tailwind-merge": "^3.3.0",
    "lucide-react": "^1.0.0"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/test-config": "workspace:*",
    "@repo/testing": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "catalog:storybook",
    "@storybook/addon-docs": "catalog:storybook",
    "@storybook/react-vite": "catalog:storybook",
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "^9.36.0",
    "jsdom": "^27.0.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:storybook",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "^7.1.0",
    "vitest": "catalog:"
  }
}
